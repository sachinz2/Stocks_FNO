# Virtual environment
venv/
.venv/
env/

# Environment secrets — NEVER commit
.env

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# IDE
.vscode/
.idea/
*.swp

# Logs
logs/
*.log

# Docker volumes
postgres_data/
mysql_data/
redis_data/

# Build artifacts
dist/
build/
*.egg-info/

# Test cache
.pytest_cache/
.coverage
htmlcov/

# ML models (large files) -- anchored to repo root so it doesn't also match
# src/database/models/ (a bare "models/" pattern matches any directory with
# that name anywhere in the tree, which silently blocked new SQLAlchemy
# model files there from ever being tracked -- found 2026-08-13 when
# capital_period.py didn't show up in `git status`).
/models/
*.pkl
*.joblib
